class 默认配置:
    # 全局公共配置
    文字识别阈值 = 0.80
    图像置信度 = 0.85
    区域缩放范围 = [0.99, 1]

    # AScript 宿主 APP 包名：防休眠加固、后台白名单等系统命令的目标应用
    AScript宿主包名 = "com.aojoy.airscript"

    # 抖动半径：模拟真人点击坐标的随机偏移
    抖动半径 = 5

    # 点击配置
    # 触点时长去固定化：抖动时长为随机区间上下限；点击时长与业务显式传入的 时长 均按「中位数」解释，
    # 实际取值在 ±触点时长抖动比例 内随机。比例置 0 即回退为原固定时长。
    点击时长 = 60
    触点时长抖动比例 = 0.2
    抖动时长最小值 = 40
    抖动时长最大值 = 80

    # 滑动配置
    滑动时长 = 1500

    # 等待配置
    等待秒数 = 1

    # 点击落定配置：点变/等点变 等待判据区域「变化后归于静止」的最长时长
    变化超时 = 2.5

    # 落定检测的帧差探测间隔（点变 每多久截一帧比对是否变化并静止）
    变化探测间隔 = 0.1

    # 等显命中后、点击前的缓冲时长：给界面渲染留时间，降低卡顿下点击落空（等点消/等点变用）
    点前等待 = 0.15

    # 点击执行后的缓冲时长：给点击响应/界面转场留时间（链式 点() 统一生效）
    点后等待 = 0.15

    # 图片等待配置
    图片等待时间 = 5
    图片识别频率 = 0.5

    # 文字等待配置
    文字等待时间 = 5
    文字识别频率 = 0.5

    # 设备播报配置
    设备播报默认消息 = "语音播报提示"
    设备播报默认次数 = 1
